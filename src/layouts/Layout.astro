---
import '../styles/globals.css';

interface Props {
    title: string;
    description?: string;
}

const { title, description = 'Play arcade games, earn gems, and unlock cosmetics.' } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </head>
    <body class="antialiased text-zinc-100 bg-[#0b0a1a] font-sans">
        <slot />
    </body>
</html>
